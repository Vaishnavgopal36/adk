# Copy these entries into my_agent/.env (which is gitignored).
# Preserve your existing Gemini/model settings.
NOTION_API_KEY=replace_with_notion_integration_token
# Use the data source UUID, not the enclosing database/container ID.
NOTION_DATA_SOURCE_ID=replace_with_notion_data_source_uuid

# Match your Notion data source properties exactly:
# title property, date property, and select property respectively.
NOTION_TITLE_PROPERTY=Name
NOTION_DUE_PROPERTY=Due date
NOTION_PRIORITY_PROPERTY=Priority
# Priority select options when used: Low, Medium, High.
# Description is stored in the page body. Status uses the database default.
